# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# ESP32-C3 无 PSRAM，故不设 CONFIG_SPIRAM。

# --- Flash ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头、关闭 detect，便于 idf.py merge-bin 出可整片刷写的合并镜像。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台：USB-Serial-JTAG（C3 原生 USB，GPIO18/19）---
# 不用 UART0：它的默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=20
# 中文字库不做 4bpp 抗锯齿（体积换覆盖率），2bpp 在 240x320 上够看。
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# 必须用 LV_MEM_SIZE（字节）：LV_MEM_SIZE_KILOBYTES 在 LVGL 9.5 已废弃且**不生效**，
# 默认值 64KB 会把内存吃爆 —— 64K(LVGL) + 60K(BLE) + 16K(重组缓冲) + 15K(待办列表)
# 远超这块板子无 PSRAM 的可用堆。
CONFIG_LV_MEM_SIZE=32768

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
# BLE + UI 同时跑，看门狗留宽一点，避免正常的长写触发 panic。
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# --- Bluetooth LE / NimBLE ---
# 设备只做 peripheral + GATT server；手机是 central。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
# 必须开：否则每次重启都要重新配对，绑定信息不落 NVS。
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
# 手机侧 requestMtu(247)，这里给足余量。
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
